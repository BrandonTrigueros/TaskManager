# ─── Network (local) ──────────────────────────────────────────
# Todo corre en esta máquina: no hay hub remoto.
BT_DB_HOST=localhost
BT_DB_PORT=5432

# ─── PostgreSQL (Hub LOQ) ────────────────────────────────────
POSTGRES_DB=heartbeat
POSTGRES_USER=hb_admin
POSTGRES_PASSWORD=dev_password_local

# ─── Database DSN ─────────────────────────────────────────────
BT_DB_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${BT_DB_HOST}:${BT_DB_PORT}/${POSTGRES_DB}

# ─── IA Híbrida ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_API_KEY=your_deepseek_api_key
BT_OLLAMA_URL=http://localhost:11434
BT_OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Heartbeat ────────────────────────────────────────────────
# Hora local a la que `--action all` incluye la consolidación de sueño
# (poda, fusión de comunidades, archivado >90 d). Default 3.
HEARTBEAT_SLEEP_HOUR=3

# ─── API local (cliente Android) ──────────────────────────────
API_HOST=0.0.0.0
API_PORT=8787
# Token de dispositivo. La app lo envía como Bearer; vacío = sin auth (solo LAN).
API_TOKEN=
