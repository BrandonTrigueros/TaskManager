# ─── Network (Tailscale) ──────────────────────────────────────
BT_HUB_IP=100.x.x.x              # IP de Tailscale de tu LOQ
BT_DB_HOST=${BT_HUB_IP}
BT_DB_PORT=5432

# ─── PostgreSQL (Hub LOQ) ────────────────────────────────────
POSTGRES_DB=heartbeat
POSTGRES_USER=hb_admin
POSTGRES_PASSWORD=dev_password_local

# ─── Database DSN ─────────────────────────────────────────────
BT_DB_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${BT_DB_HOST}:${BT_DB_PORT}/${POSTGRES_DB}

# ─── IA Híbrida ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_API_KEY=your_deepseek_api_key
BT_OLLAMA_URL=http://${BT_HUB_IP}:11434
BT_OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Heartbeat ────────────────────────────────────────────────
# Hora local a la que `--action all` incluye la consolidación de sueño
# (poda, fusión de comunidades, archivado >90 d). Default 3.
HEARTBEAT_SLEEP_HOUR=3

# ─── Telegram (Triple Bot) ────────────────────────────────────
BT_TASKS_BOT_TOKEN=your_tasks_bot_token         # @bt_task_bot
BT_FINANCE_BOT_TOKEN=your_finance_bot_token     # @bt_finance_bot
BT_IDEAVAULT_BOT_TOKEN=your_ideavault_bot_token # @bt_ideavault_bot
BT_ALLOWED_USER_ID=your_telegram_user_id
